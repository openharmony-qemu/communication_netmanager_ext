+            if (!next.empty() && next == qemuLastConfig_ && qemuConfigured_) response = NETMANAGER_EXT_SUCCESS;
+            else if (!qemuTunReady_) {
+                response = UpdateQemuConfig(config);
+                if (response == NETMANAGER_EXT_SUCCESS) qemuLastConfig_ = next;
